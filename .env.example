# ==============================================================================
# AI VISION STUDIO — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env for local development:
#   cp .env.example .env
# ==============================================================================

# Server Configuration
NODE_ENV=development
PORT=5000
SERVER_HOST=0.0.0.0
CLIENT_URL=http://localhost:5173

# Database (PostgreSQL & Prisma)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_vision_studio?schema=public

# Authentication & Security (JWT)
JWT_SECRET=development_jwt_secret_change_in_production_min_32_chars_long
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=development_refresh_secret_change_in_production_min_32_chars
JWT_REFRESH_EXPIRES_IN=30d
COOKIE_SECRET=development_cookie_secret_change_in_production

# Internal Service-to-Service Security (Shared with Python AI Service)
INTERNAL_SERVICE_KEY=ai_vision_studio_internal_rpc_secret_key_min_32_chars
AI_SERVICE_URL=http://localhost:8000

# Stream Video API Credentials
STREAM_API_KEY=
STREAM_API_SECRET=

# Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Stripe Billing & Subscriptions
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRODUCT_ID=
STRIPE_PRO_PRICE_ID=
STRIPE_PRO_YEARLY_PRICE_ID=
STRIPE_BUSINESS_PRODUCT_ID=
STRIPE_BUSINESS_PRICE_ID=
STRIPE_BUSINESS_YEARLY_PRICE_ID=
STRIPE_ENTERPRISE_PRODUCT_ID=
STRIPE_ENTERPRISE_PRICE_ID=
STRIPE_ENTERPRISE_YEARLY_PRICE_ID=

# Media Storage (Cloudinary)
CLOUDINARY_CLOUD_NAME=placeholder_cloud_name
CLOUDINARY_API_KEY=placeholder_api_key
CLOUDINARY_API_SECRET=placeholder_api_secret

# Email Delivery (Nodemailer & Brevo)
EMAIL_PROVIDER=nodemailer
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="AI Vision Studio <support@aivisionstudio.com>"
EMAIL_FROM_NAME="AI Vision Studio"
EMAIL_FROM_ADDRESS="AI Vision Studio <support@aivisionstudio.com>"
EMAIL_LOGO_URL=

BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME="AI Vision Studio"
